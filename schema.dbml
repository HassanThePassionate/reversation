// Paste this into https://dbdiagram.io (Import -> DBML) and use Share to get the link.

Enum role {
  ADMIN
  MEMBER
}

Enum reservation_status {
  CONFIRMED
  CANCELLED
}

Table teams {
  id text [pk, note: 'Generated by Prisma cuid()']
  name text [unique, not null]
  createdAt timestamptz [not null, default: `now()`]
}

Table users {
  id text [pk, note: 'Generated by Prisma cuid()']
  name text [not null]
  email text [unique, not null]
  passwordHash text [not null]
  role role [not null, default: 'MEMBER']
  teamId text [ref: > teams.id]
  createdAt timestamptz [not null, default: `now()`]
}

Table resource_types {
  id text [pk, note: 'Generated by Prisma cuid()']
  name text [unique, not null]
  description text
}

Table resources {
  id text [pk, note: 'Generated by Prisma cuid()']
  name text [not null]
  typeId text [not null, ref: > resource_types.id]
  location text
  capacity int
  description text
  openTime text [not null, default: '08:00', note: 'HH:mm in organization timezone']
  closeTime text [not null, default: '20:00']
  isActive boolean [not null, default: true]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null]

  indexes {
    typeId
    (isActive, name)
  }
}

Table reservations {
  id text [pk, note: 'Generated by Prisma cuid()']
  resourceId text [not null, ref: > resources.id]
  userId text [not null, ref: > users.id]
  teamId text [ref: > teams.id]
  title text [not null]
  notes text
  startTime timestamptz [not null]
  endTime timestamptz [not null]
  status reservation_status [not null, default: 'CONFIRMED']
  cancelledAt timestamptz
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null]

  indexes {
    (resourceId, startTime)
    (userId, startTime)
    (status, startTime, endTime)
    (userId, status, startTime)
  }

  Note: '''
  Foreign-key delete rules: users.teamId and reservations.teamId use SET NULL;
  resources.typeId, reservations.resourceId and reservations.userId use RESTRICT.
  All foreign keys use ON UPDATE CASCADE.
  The GiST exclusion constraint requires CREATE EXTENSION btree_gist.
  CHECK (endTime > startTime)
  EXCLUDE USING gist (resourceId WITH =, tstzrange(startTime, endTime, '[)') WITH &&)
    WHERE (status = 'CONFIRMED')
  -> prevents double booking at the database level, even under concurrent requests.
  '''
}
